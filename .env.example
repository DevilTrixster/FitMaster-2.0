PORT=3000
# Данные локальной базы
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=fitmaster_db

JWT_SECRET=secret-key

# Для миграции
DATABASE_URL=postgresql://user:password@localhost:5432/fitmaster_db

AI_DATABASE_URL=postgresql://user:password@localhost:5432/ai-fitmaster

# JWT secret
ACCESS_TOKEN_SECRET = secret

# Для нейросети
API_KEY = sk-or-...
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=qwen/qwen3.8-27b:free # openrouter/free

# Связь Node/TypeScript -> Python AI-service
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=180000
AI_GENERATION_TIMEOUT_SECONDS=45

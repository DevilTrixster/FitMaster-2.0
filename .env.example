PORT=3000
# Данные локальной базы
DB_HOST=localhost
DB_PORT=5432
DB_USER=name
DB_PASSWORD=password
DB_NAME=DB

JWT_SECRET=fitmaster-super-secret-key-change-in-production

# Для миграции
DATABASE_URL=postgresql://(логин):(пароль)@localhost:(port)/(БД)

# JWT secret
ACCESS_TOKEN_SECRET = secret_token

# Для нейросети
API_KEY=sk-or...
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=qwen/qwen3.8-27b:free

# Связь Node/TypeScript -> Python AI-service
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=60000

# Отдельная БД базы знаний AI
AI_DB_HOST=localhost
AI_DB_PORT=5432
AI_DB_USER=postgres
AI_DB_PASSWORD=password
AI_DB_NAME=ai-fitmaster
# Либо одной строкой:
# AI_DATABASE_URL=postgresql://postgres:password@localhost:5432/ai-fitmaster